# ── Supabase Database ────────────────────────────────────────────────────────────
# From: Supabase → Connect → Transaction pooler → URI
# Replace [YOUR-PASSWORD] with your actual database password
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── Supabase API (Server-side) ───────────────────────────────────────────────────
# From: Supabase → Settings → API Keys → Project URL
SUPABASE_URL=https://xxxx.supabase.co

# From: Supabase → Settings → API Keys → Secret key
# Keep this secret — never expose to the browser
SUPABASE_SECRET_KEY=sb_secret_...

# ── Supabase API (Client/browser-side) ──────────────────────────────────────────
# Same project URL as above — safe to expose publicly
VITE_SUPABASE_URL=https://xxxx.supabase.co

# From: Supabase → Settings → API Keys → Publishable key
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Session ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# ── App ───────────────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Seed (optional) ──────────────────────────────────────────────────────────────
# Set SEED=true on first deploy only to insert demo data. Remove after first boot.
# SEED=true
# SEED_PASSWORD=ChangeThisBeforeSeeding
