# Copy this file to .env for local development.
# On Railway, set these in the service's "Variables" tab — never commit real values.

# ── Required ────────────────────────────────────────────────────────────────────

# Postgres connection string. Railway injects this automatically when you
# attach a Postgres plugin — just reference it as ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Long random secret for signing session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# ── Optional ────────────────────────────────────────────────────────────────────

# Set to "production" on Railway (Railway sets this automatically).
NODE_ENV=production

# Port to listen on. Railway sets this automatically — do not override it.
# PORT=5000

# Set to "true" only on the very first deploy to insert demo data.
# Remove or set to "false" after the first boot to protect real user data.
# SEED=true

# Password used for demo/seed accounts when SEED=true.
# Defaults to a built-in value if not set — override this in production.
# SEED_PASSWORD=ChangeThisBeforeSeeding
