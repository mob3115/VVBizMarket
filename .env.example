# ── Supabase ────────────────────────────────────────────────────────────────────
# From: Supabase → Connect → Direct (Transaction pooler) → URI
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# From: Supabase → Settings → API Keys → Project URL
SUPABASE_URL=https://xxxx.supabase.co

# From: Supabase → Settings → API Keys → Secret key (sb_secret_...)
SUPABASE_SECRET_KEY=sb_secret_...

# ── Frontend (Vite exposes these to the browser) ────────────────────────────────
# From: Supabase → Settings → API Keys → Project URL (same as above)
VITE_SUPABASE_URL=https://xxxx.supabase.co

# From: Supabase → Settings → API Keys → Publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Session ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# ── App ─────────────────────────────────────────────────────────────────────────
NODE_ENV=production

# Set to "true" only on first deploy to insert demo data, then remove
# SEED=true
# SEED_PASSWORD=ChangeThisBeforeSeeding
