{
  "version": 2,
  "buildCommand": "npm install && npm run build",
  "installCommand": "npm install --include=dev",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/dist/public/index.html"
    }
  ]
}
